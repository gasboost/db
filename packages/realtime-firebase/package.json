{
  "name": "@gasboost/realtime-firebase",
  "version": "0.8.0",
  "description": "Table Version notifications for Firebase Realtime Database and GAS Custom Tokens",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gasboost/db.git",
    "directory": "packages/realtime-firebase"
  },
  "license": "MIT",
  "author": "tiger-oshima",
  "keywords": [
    "firebase",
    "firebase-realtime-database",
    "google-apps-script",
    "version-notifications",
    "typescript"
  ],
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "require": "./dist/client.js",
      "default": "./dist/client.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "pack": "pnpm pack"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@gasboost/fake-node": "^0.1.1",
    "@types/google-apps-script": "^2.0.12",
    "@types/node": "^26.4.1",
    "zod": "^4.5.4"
  },
  "dependencies": {
    "@gasboost/table": "workspace:*"
  }
}
